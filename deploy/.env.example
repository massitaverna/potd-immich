# --- Used by compose.yaml (host side) ---

# Image tag, e.g. 0.1.0 to pin a release
POTD_VERSION=latest
# Host directory holding state.json and blocklist.yaml (must be owned by uid 65532)
DATA_LOCATION=/srv/potd-immich
# Host file containing only the Immich API key (must be owned by uid 65532)
API_KEY_LOCATION=./api-key

# --- Read by potd-immich ---

# host.docker.internal is the Docker host; change the port if Immich is published on another one
POTD_API_URL=http://host.docker.internal:2283
POTD_ALBUM_NAME="Photo of the day"
POTD_AVOID_REPEAT_DAYS=60
# Daily run time (HH:MM) and its IANA time zone, e.g. Europe/Zurich
POTD_SCHEDULE_TIME=06:00
POTD_SCHEDULE_TIMEZONE=UTC
